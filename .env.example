# =====================================================================
#  RDXXB Radar Simulator — Environment Example
#  ─────────────────────────────────────────────────────────────────
#  Copy file ini menjadi .env lalu sesuaikan nilainya:
#    cp .env.example .env
#
#  CATATAN: Sistem ini utamanya membaca konfigurasi dari
#  runtime-config.json (bukan .env). File .env hanya berlaku
#  untuk nilai yang sengaja dibaca dari environment variable.
#  Lihat bagian "Port Quick-Reference" di README untuk detail.
# =====================================================================

# ── Webapp ──────────────────────────────────────────────────────────
# Port HTTP untuk dashboard web (default: 3000)
# Cara pakai: set di runtime-config.json → "webapp": { "port": 3000 }
WEBAPP_PORT=3002

# ── MQTT Broker ─────────────────────────────────────────────────────
# Port TCP MQTT (default Mosquitto: 1883)
MQTT_TCP_PORT=1883

# Port WebSocket MQTT untuk browser (default Mosquitto: 9001)
MQTT_WS_PORT=9001

# Host MQTT broker
MQTT_HOST=127.0.0.1

# Kredensial MQTT (kosongkan jika broker tanpa auth)
MQTT_USERNAME=
MQTT_PASSWORD=

# ── UDP Parser ──────────────────────────────────────────────────────
# Port UDP tempat parser mendengarkan frame RDXXB dari radar
UDP_HOST=0.0.0.0
UDP_PORT=20202

# ── Simulator ───────────────────────────────────────────────────────
# Interval kirim data simulasi (milidetik)
SIM_PUBLISH_INTERVAL_MS=5000

# Jumlah target yang disimulasikan
SIM_TARGET_COUNT=5
