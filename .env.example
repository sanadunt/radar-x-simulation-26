# Production variables for Hostinger (set these in hPanel).
# The application does not load .env automatically.
NODE_ENV=production
WEBAPP_AUTH_USER=
WEBAPP_AUTH_PASSWORD=

# Optional: path to a writable file on persistent storage; its parent directory
# must already exist.
# RDXXB_RUNTIME_CONFIG_PATH=/path/to/persistent/runtime-config.json

# Hostinger provides PORT automatically. Do not hardcode the public port here.
# Locally, runtime-config.json's webapp.port is used as a fallback.
# HOST defaults to 0.0.0.0; override only if required.
# HOST=0.0.0.0
